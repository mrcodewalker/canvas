<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A11">

    <!-- 1. The Canvas Surface (Fills entire screen) -->
    <com.example.canvas.ui.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Top Section Container (Padded dynamically by WindowInsets for status bar & camera notch) -->
    <LinearLayout
        android:id="@+id/topContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:elevation="16dp">

        <!-- Top App Bar Ribbon -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E60D121D"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Mode Badge Capsule -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvMode"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minHeight="38dp"
                    android:text="TIERED ▾"
                    android:textStyle="bold"
                    android:textColor="#10B981"
                    android:textSize="12.5sp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/bg_toolbar_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="6dp" />

                <!-- Vertical Hairline Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="#26344A"
                    android:layout_marginEnd="6dp" />

                <!-- Undo / Redo / Clear -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnUndo"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="38dp"
                    android:text="↶ Undo"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_toolbar_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="5dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRedo"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="38dp"
                    android:text="↷ Redo"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_toolbar_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="5dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnClear"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="38dp"
                    android:text="✕ Clear"
                    android:textAllCaps="false"
                    android:textColor="#F87171"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_toolbar_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="6dp" />

                <!-- Vertical Hairline Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="#26344A"
                    android:layout_marginEnd="6dp" />

                <!-- HUD X-Ray Toggle -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnToggleXRay"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="38dp"
                    android:text="📡 HUD X-Ray"
                    android:textAllCaps="false"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_toolbar_pill_accent"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="5dp" />

                <!-- Stress Test -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStress"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="38dp"
                    android:text="⚡ Stress"
                    android:textAllCaps="false"
                    android:textColor="#FB7185"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_toolbar_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="5dp" />

                <!-- Demo 3P -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDemo3Min"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="38dp"
                    android:text="▶ Demo 3P"
                    android:textAllCaps="false"
                    android:textColor="#FBBF24"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_toolbar_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="5dp" />

                <!-- Benchmark -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBenchmark"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="38dp"
                    android:text="📊 Bench"
                    android:textAllCaps="false"
                    android:textColor="#34D399"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_toolbar_pill"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Memory X-Ray HUD (Placed safely below the top bar, guaranteed zero overlap) -->
        <com.example.canvas.ui.XRayView
            android:id="@+id/xRayView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="6dp"
            android:visibility="visible" />

    </LinearLayout>

    <!-- 3. Bottom Section Container (Padded dynamically by WindowInsets for navigation bar) -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:elevation="16dp">

        <!-- Demo Narration Banner (Overlay when 3-min automated demo runs) -->
        <LinearLayout
            android:id="@+id/demoBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_floating_dock"
            android:padding="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDemoPhase"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PHASE 1: NAIVE (0:00 / 3:00)"
                    android:textColor="#FBBF24"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnStopDemo"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Stop Demo"
                    android:textAllCaps="false"
                    android:textColor="#F87171"
                    android:textSize="11sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/bg_toolbar_pill" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbDemoProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="180"
                android:progress="0"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvDemoInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Observing memory dynamics..."
                android:textColor="#E2E8F0"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Compact Status Readout Pill -->
        <TextView
            android:id="@+id/tvStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbar_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginBottom="6dp"
            android:text="Steps: 0 | Hot: 0.0 MB | Warm: 0.0 MB | Cold: 0.0 MB"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:fontFamily="monospace" />

        <!-- Floating Studio Dock (Artist Island: Brushes, Colors, Fill 16MB) -->
        <HorizontalScrollView
            android:id="@+id/floatingDock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_floating_dock"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Brush Sizes -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBrushSmall"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="S"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:background="@drawable/bg_brush_button_normal"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="5dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBrushMedium"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="M"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_brush_button_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="5dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBrushLarge"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="L"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:background="@drawable/bg_brush_button_normal"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="5dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBrushXL"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="XL"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    android:background="@drawable/bg_brush_button_normal"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="10dp" />

                <!-- Vertical Hairline Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="#26344A"
                    android:layout_marginEnd="10dp" />

                <!-- Studio Palette Colors -->
                <View
                    android:id="@+id/colorBlack"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_color_circle"
                    android:backgroundTint="#000000"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <View
                    android:id="@+id/colorRed"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_color_circle"
                    android:backgroundTint="#EF4444"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <View
                    android:id="@+id/colorBlue"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_color_circle"
                    android:backgroundTint="#3B82F6"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <View
                    android:id="@+id/colorGreen"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_color_circle"
                    android:backgroundTint="#10B981"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp" />

                <View
                    android:id="@+id/colorWhite"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_color_circle"
                    android:backgroundTint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="10dp" />

                <!-- Vertical Hairline Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:background="#26344A"
                    android:layout_marginEnd="10dp" />

                <!-- Fill 16MB Action Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFill"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="36dp"
                    android:text="🎨 Fill 16M"
                    android:textAllCaps="false"
                    android:textColor="#FBBF24"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_toolbar_pill"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

</FrameLayout>
